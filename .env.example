# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rechargepro?schema=public"

# Auth
JWT_SECRET="change-this-to-a-random-64-char-string"
JWT_EXPIRES_IN="24h"

# App
NEXT_PUBLIC_APP_NAME="Recharge Pro"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"
DEMO_MODE="true"

# Master Admin (used only during initial seed)
MASTER_ADMIN_EMAIL="admin@rechargepro.in"
MASTER_ADMIN_PASSWORD="change-this-immediately"
MASTER_ADMIN_MOBILE="9999999999"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Timezone
TZ="Asia/Kolkata"
